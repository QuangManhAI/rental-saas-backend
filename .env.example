# =============================================================
# RENTAL SAAS BACKEND — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# Run scripts/generate-secrets.sh to generate secure secret values.
# =============================================================

# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/rental-saas
MONGO_DB=rental-saas

# ── JWT (generate with scripts/generate-secrets.sh) ──────────
JWT_SECRET=CHANGE_ME_MIN_64_CHARS
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_FROM_JWT_SECRET_MIN_64_CHARS
JWT_REFRESH_EXPIRATION=7d

# ── Encryption Master Key (AES-256-GCM, 32-byte hex = 64 hex chars) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=CHANGE_ME_32_BYTES_HEX_64_CHARS

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins. No wildcards in production.
ALLOWED_ORIGINS=http://localhost:3001

# ── Tenant JWT (separate from owner JWT) ──────────────────────
TENANT_JWT_SECRET=CHANGE_ME_TENANT_JWT_SECRET_MIN_64_CHARS
TENANT_JWT_EXPIRATION=30d

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_bot_username
# Webhook secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_MIN_32_CHARS
FRONTEND_URL=http://localhost:3001

# ── VNPay (per-owner credentials stored in PaymentSettings) ──────────
VNPAY_RETURN_URL=http://localhost:3001/tenant/payment/result
VNPAY_IPN_URL=http://your-public-domain/api/v1/vnpay/ipn

# ── MoMo (per-owner credentials are stored in PaymentSettings) ────────
# These are only used as last-resort sandbox fallback for development.
# In production, each owner configures their own credentials.
MOMO_REDIRECT_URL=http://localhost:3001/payment/result
MOMO_IPN_URL=http://your-public-domain/api/momo/ipn

# ── SMTP Email ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
MAIL_FROM="Rental SaaS <noreply@yourdomain.com>"

# ── Cloudflare R2 Storage ─────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=excel-rental
R2_PUBLIC_URL=
